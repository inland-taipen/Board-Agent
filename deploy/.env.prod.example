# BoardLens production settings. Copy to `.env` on the server and fill in.
#
# Generate the two secrets with the commands shown; do not invent them by hand
# and do not reuse the values from the development .env.

# The domain this will be served on. It must already point at this server's
# public IP - Caddy verifies over port 80 before issuing a certificate.
BOARDLENS_HOSTNAME=boardlens.example.com

# --- model provider -----------------------------------------------------------
BOARDLENS_PROVIDER=gemini
GEMINI_API_KEY=
BOARDLENS_GEMINI_MODEL=gemini-3.7-flash

# --- secrets ------------------------------------------------------------------
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this later makes every already-uploaded pack undecryptable.
BOARDLENS_ENCRYPTION_KEY=

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BOARDLENS_JWT_SECRET=

# --- first administrator ------------------------------------------------------
# Created once, on first start. Everyone else is added from the People screen.
BOARDLENS_BOOTSTRAP_EMAIL=you@stairdigital.com
BOARDLENS_BOOTSTRAP_PASSWORD=

BOARDLENS_MAX_UPLOAD_MB=200

# ---- Model provider ---------------------------------------------------------
# Which backend writes the briefing: auto | anthropic | gemini | groq
#
# "auto" uses whichever key below is present, preferring the provider best
# suited to a 500-page board pack (anthropic -> gemini -> groq). PIN THIS IN
# PRODUCTION: with "auto", adding an unrelated key to the environment silently
# changes which model writes the board's briefing.
BOARDLENS_PROVIDER=auto

# Set the key for whichever provider you are using. You need exactly one.
#   Anthropic  https://console.anthropic.com/settings/keys
#   Gemini     https://aistudio.google.com/apikey
#   Groq       https://console.groq.com/keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs per provider. Check these against the provider's own model list
# before a pilot - they move faster than this file does.
#
# Board briefings are low-error-tolerance work. Prefer the strongest tier your
# budget allows, and do not downgrade without reviewing accuracy on a real pack.
BOARDLENS_MODEL=claude-opus-5
BOARDLENS_GEMINI_MODEL=gemini-3.7-flash
BOARDLENS_GROQ_MODEL=openai/gpt-oss-120b

# Effort for the synthesis pass: low | medium | high | xhigh | max
# Honoured by Anthropic and (as low/medium/high) by Groq. Gemini ignores it -
# choose the model tier there instead.
BOARDLENS_EFFORT=high

# ---- Storage ----------------------------------------------------------------
# Root for the SQLite database, encrypted blob store and vector indexes.
BOARDLENS_DATA_DIR=./storage

# Fernet key for encryption-at-rest of uploaded board packs.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated on first run and written to $BOARDLENS_DATA_DIR/.master.key
BOARDLENS_ENCRYPTION_KEY=

# ---- Auth -------------------------------------------------------------------
# HMAC secret for session JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOARDLENS_JWT_SECRET=change-me-in-production
BOARDLENS_JWT_TTL_MINUTES=480

# Bootstrap administrator, created on first run only.
BOARDLENS_BOOTSTRAP_EMAIL=admin@stairdigital.example
BOARDLENS_BOOTSTRAP_PASSWORD=change-me

# ---- Retrieval --------------------------------------------------------------
# Dense retrieval requires the optional [dense] extra (sentence-transformers).
# When false, BoardLens uses BM25 lexical retrieval only.
BOARDLENS_DENSE_RETRIEVAL=false
BOARDLENS_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Limits -----------------------------------------------------------------
BOARDLENS_MAX_UPLOAD_MB=200
BOARDLENS_CORS_ORIGINS=http://localhost:5173

# Path to the built web interface. Leave empty in development (it is found
# relative to the repository); the container image sets it explicitly.
BOARDLENS_WEB_DIR=
